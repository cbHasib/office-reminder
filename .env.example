# Copy this file to .env.local in apps/web/ and apps/desktop/

# Supabase project URL — found in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — safe to ship in client apps. RLS policies do the access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Service role key — NEVER ship to clients. Only used by server-side admin scripts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# GitHub repo for the /download page in apps/web. Format: "owner/repo".
# Set this in Vercel too once you deploy.
NEXT_PUBLIC_GITHUB_REPO=your-username/office-reminder

NEXT_PUBLIC_SUPABASE_URL=https://ylcesvmhoaiaouzhzatw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t7YDgfMi8esSOc7mAE3FfA__yOpEJPi