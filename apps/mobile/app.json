{
  "expo": {
    "name": "Office Reminder",
    "slug": "office-reminder",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.officereminder.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F12"
      },
      "package": "com.officereminder.mobile",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F12"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F0F12",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/ding.wav",
            "./assets/sounds/soft.wav",
            "./assets/sounds/alert.wav"
          ],
          "androidMode": "default",
          "androidCollapsedTitle": "Office Reminder"
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": true,
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "ReminderCountdownActivity",
              "displayName": "Reminder Countdown",
              "description": "Shows a live countdown for the next office reminder.",
              "contentMarginsDisabled": false,
              "supportedFamilies": [
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ],
      "expo-audio"
    ],
    "scheme": "officereminder",
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.officereminder.mobile.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.officereminder.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "e8634232-d08d-4fb8-90a4-3a3dce3b663b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e8634232-d08d-4fb8-90a4-3a3dce3b663b"
    }
  }
}
